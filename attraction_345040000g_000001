    <script>
        (function () {

            const type_ary = ['Attraction', 'Event', 'Hotel', 'Restaurant', 'TourismServiceSite', 'CyclingRoute', 'Trail']
            const class_ary = ['AttractionClass', 'EventClass', 'HotelClass', 'CuisineClass', 'TourismServiceSiteClass', 'CyclingRouteClass', 'TrailClass']

            $('input[name="DataCode"]').on('change', function () {
                $(this).parent().siblings().prop("title", "")
                $(this).parent().prop("title", "已勾選")
                setClassFilters()
            });

            $('form').on('submit', function () {
                let val = $('input[name="DataCode"]:checked').val()
                let sel_idx = type_ary.indexOf(val)
                clearClassFilters(sel_idx)
            })

            setClassFilters()

            function setClassFilters() {
                $('.filter-class1').addClass('d-none')

                let val = $('input[name="DataCode"]:checked').val()

                if (val == 'Attraction') $('#div-attraction-class').removeClass('d-none')
                else if (val == 'Event') $('#div-event-class').removeClass('d-none')
                else if (val == 'Hotel') $('#div-hotel-class').removeClass('d-none')
                else if (val == 'Restaurant') $('#div-cuisine-class').removeClass('d-none')
                else if (val == 'TourismServiceSite') $('#div-site-class').removeClass('d-none')
                else if (val == 'CyclingRoute') $('#div-cycling-class').removeClass('d-none')
                else if (val == 'Trail') $('#div-trail-class').removeClass('d-none')
            }

            function clearClassFilters(selected_index) {
                for (let i = 0; i < class_ary.length; i++) {
                    if (i == selected_index) continue
                    $('#' + class_ary[i]).val('')
                }
            }
        })();
    </script>

